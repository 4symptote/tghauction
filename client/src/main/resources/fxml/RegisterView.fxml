<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="620.0" prefWidth="500.0"
            stylesheets="@../css/app.css"
            styleClass="login-root"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.app.client.controller.RegisterController">
    <padding>
        <Insets bottom="34.0" left="34.0" right="34.0" top="34.0"/>
    </padding>

    <center>
        <VBox alignment="CENTER_LEFT" spacing="16.0" styleClass="auth-panel">
            <Label text="Create Account" styleClass="brand-title"/>
            <Label text="Join live auctions as a bidder, seller, or admin." styleClass="muted-text"/>

            <VBox spacing="8.0">
                <Label text="Username" styleClass="field-label"/>
                <TextField fx:id="usernameField" promptText="Choose a username" prefHeight="42.0" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="8.0">
                <Label text="Email" styleClass="field-label"/>
                <TextField fx:id="emailField" promptText="you@example.com" prefHeight="42.0" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="8.0">
                <Label text="Role" styleClass="field-label"/>
                <ComboBox fx:id="roleComboBox" prefHeight="42.0" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="8.0">
                <Label text="Password" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" promptText="At least 4 characters" prefHeight="42.0" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="8.0">
                <Label text="Confirm Password" styleClass="field-label"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Re-enter your password" prefHeight="42.0" maxWidth="Infinity"/>
            </VBox>

            <Label fx:id="errorLabel" managed="true" visible="false" styleClass="error-text"/>

            <Button fx:id="registerButton"
                    text="Register"
                    onAction="#handleRegister"
                    prefHeight="44.0"
                    maxWidth="Infinity"
                    styleClass="primary-button"/>

            <HBox alignment="CENTER" spacing="8.0">
                <Label text="Already registered?" styleClass="muted-text"/>
                <Button text="Back to Login" onAction="#handleBackToLogin" styleClass="link-button"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>

